# Per-repo configuration for the shared FuguBSD tooling. The synced
# scripts read their identity keys here. See FuguBSD/Tooling.
sync.pack org
sync.pack perl
dist.name     Fugu
dist.module   Fugu
dist.abstract OpenBSD-style daemon utilities for Perl
dist.author   Dick Olsson <hi@senzilla.io>
dist.testdir  t/fugu
dist.testdir  t/protocol
dist.testdir  t/conformance
