#
# The org ignore list. One list serves every consumer, so it holds
# the union of all consumer needs. A pattern that a repository does
# not use is harmless there.

# Secrets
.env
.claude/settings.local.json*

# Scratch space of the development rules
explore/
SCRATCHPAD*.md
.claude/worktrees/

# Project clones of the workspace checkout
Projects/

# Operating system
.DS_Store

# Editors
.idea/
.vscode/

# Website build
web/build/

# Perl build
build/
local/
external/
*.cat1

# Python build
.venv/
__pycache__/
*.egg-info/
.ruff_cache/
.pytest_cache/

# OpenTofu state
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.auto.tfvars
*.tfplan
crash.log
